{
  "name": "charterion",
  "version": "0.4.1",
  "private": true,
  "description": "Open-source multi-agent engineering control plane for ChatGPT Web Agents.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run --pool=forks --fileParallelism=false",
    "verify": "npm run check && npm run check:control && npm run check:assets && npm run check:readme-i18n && npm run test && npm run build && npm run build:control",
    "check:assets": "node scripts/check-assets.mjs",
    "release": "npm run verify:full && npm run check:readme-i18n:release && npm run third-party-notices && node scripts/package-release.mjs && node scripts/package-runtime.mjs",
    "check:control": "tsc -p tsconfig.control.json --noEmit",
    "build:control": "node scripts/build-control.mjs",
    "test:control": "vitest run control/tests",
    "gamd": "node dist-control/gamd.cjs",
    "gamctl": "node dist-control/gamctl.cjs",
    "smoke:control": "npm run build:control && node scripts/smoke-control.mjs",
    "build:native": "dotnet build native-host/GamNativeHost/GamNativeHost.csproj -c Release",
    "smoke:native": "npm run build:control && npm run publish:native && node scripts/smoke-native-host.mjs",
    "gam": "node dist-control/gam.cjs",
    "gam:start": "node dist-control/gam.cjs start",
    "gam:status": "node dist-control/gam.cjs status",
    "gam:doctor": "node dist-control/gam.cjs doctor",
    "publish:native": "node scripts/publish-native.mjs",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "smoke:launcher": "npm run build:control && node scripts/smoke-launcher.mjs",
    "smoke:evidence": "npm run build:control && node scripts/smoke-evidence.mjs",
    "smoke:change-request": "npm run build:control && node scripts/smoke-change-request.mjs",
    "verify:full": "npm run verify && npm run publish:native && npm run smoke:control && npm run smoke:evidence && npm run smoke:change-request && npm run smoke:fleet && npm run smoke:native && npm run smoke:runtime-install && npm run smoke:launcher",
    "package:runtime": "node scripts/package-runtime.mjs",
    "smoke:fleet": "npm run build:control && node scripts/smoke-fleet.mjs",
    "smoke:runtime-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-runtime-install.ps1",
    "readme:i18n:sync": "node scripts/readme-i18n.mjs sync-navigation",
    "readme:i18n:status": "node scripts/readme-i18n.mjs status",
    "check:readme-i18n": "node scripts/check-readme-i18n.mjs",
    "check:readme-i18n:release": "node scripts/check-readme-i18n.mjs --release",
    "third-party-notices": "node scripts/generate_third_party_notices.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
