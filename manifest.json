{
  "manifest_version": 3,
  "name": "Charterion",
  "version": "0.5.0",
  "description": "Open-source multi-agent engineering control plane for ChatGPT Web Agents.",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Open Charterion"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
